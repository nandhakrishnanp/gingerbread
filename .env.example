# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string.
#
# Most networks can use the short SRV form from MongoDB Atlas:
#   MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
#
# If SRV DNS lookups are blocked on your network, use the standard form with the
# explicit shard hosts, replica set name and authSource (Atlas "Connect" also
# offers this under "Standard connection string"):
#   MONGODB_URL=mongodb://<user>:<password>@shard-00:27017,shard-01:27017,shard-02:27017/<db>?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database name. Defaults to "gingerbread" if omitted.
MONGODB_DB=gingerbread

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-a-random-32-byte-base64-string